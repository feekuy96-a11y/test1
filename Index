async function memView(){const m=await Q(sb.from('v_member_summary').select('*').order('spent',{ascending:false}));return`<h2>สมาชิกและแต้ม</h2>${tbl(['ชื่อ','เบอร์','ระดับ','แต้ม','มา (ครั้ง)','ยอดสะสม','โปร?',''],m.map(x=>[e(x.name||'-'),e(x.phone),x.tier,x.points,x.visits,B(x.spent),x.consent_marketing?'✔':'',`<button onclick="A.redeem(${x.id})">แลกแต้ม</button>`]))}`}
def({async redeem(id){const r=await Q(sb.from('rewards').select('*').eq('active',true).order('points_cost'));modal(`<h3>แลกของรางวัล</h3>${r.map(x=>`<div class=card><div class=row><span>${e(x.name)} · ${x.points_cost} แต้ม</span><button class=p onclick="A.redeem2(${id},${x.id})">แลก</button></div></div>`).join('')||'<p>ยังไม่มีของรางวัล</p>'}`)},
async redeem2(m,r){const c=await Q(sb.rpc('redeem_reward',{p_member:m,p_reward:r}));modal(`<h3>แลกสำเร็จ ✅</h3><p>รหัส: <b class=pr style="font-size:22px">${e(c)}</b></p><small>ส่วนลดใช้ได้ 1 ครั้ง อายุ 30 วัน คีย์ที่เคาน์เตอร์ตอนชำระเงิน (ของแถมให้ส่งมอบตามรายการ)</small><p><button onclick="closeM();A.go()">ปิด</button></p>`)}});
async function repView(){const[d,t,h,c,p]=await Promise.all(['v_daily_sales:day','v_top_items:revenue','v_hourly_sales:hour','v_coupon_usage:code','v_promo_performance:name'].map(x=>{const[v,o]=x.split(':');return Q(sb.from(v).select('*').order(o,{ascending:o=='hour'||o=='code'||o=='name'}).limit(14))})),mx=Math.max(1,...h.map(x=>+x.sales));
return`<h2>รายงานผู้จัดการ</h2><div class=k2><div class=card><b>ยอดขายรายวัน</b>${tbl(['วัน','บิล','ยอดขาย','เฉลี่ย/บิล','ส่วนลดที่ให้'],d.map(x=>[x.day,x.bills,B(x.sales),B(x.avg_bill),B(x.discounts)]))}</div><div class=card><b>เมนูขายดี</b>${tbl(['เมนู','จำนวน','ยอดขาย'],t.map(x=>[e(x.name),x.qty,B(x.revenue)]))}</div></div><div class=card><b>ช่วงเวลาขายดี (ชั่วโมง)</b>${h.map(x=>`<div class=row><span style="width:50px">${x.hour}:00</span><div class=bar style="width:${x.sales/mx*70}%"></div><small>${B(x.sales)}</small></div>`).join('')}</div><div class=k2><div class=card><b>การใช้โค้ด</b>${tbl(['โค้ด','ใช้แล้ว','คงเหลือ','ส่วนลดรวม'],c.map(x=>[e(x.code),x.used_count,x.remaining??'∞',B(x.discount_given)]))}</div><div class=card><b>ผลของโปรโมชัน</b>${tbl(['โปร','ออเดอร์','ส่วนลดรวม','ยอดขาย'],p.map(x=>[e(x.name),x.orders,B(x.discount_given),B(x.sales_with_promo)]))}</div></div>`}
async function qrView(){const t=await Q(sb.from('floor_objects').select('code').in('kind',['square','round']).order('code')),base=location.origin+location.pathname;
window.after=()=>t.forEach(x=>qr($('#q_'+x.code),base+'#/t/'+encodeURIComponent(x.code)));setTimeout(()=>window.after(),0);return`<div class=row><h2>QR ประจำโต๊ะ</h2><button class="p no" onclick="print()">🖨️ พิมพ์</button></div><div class=g>${t.map(x=>`<div class=card style="text-align:center"><b>โต๊ะ ${e(x.code)}</b><div id="q_${e(x.code)}" style="display:flex;justify-content:center;padding:8px"></div><small>สแกนเพื่อสั่งอาหาร</small></div>`).join('')}</div>`}
async function setView(){const s=D.s,f=(k,l,t,v)=>`<label>${l}</label><input id=s_${k} type=${t} value="${e(v??'')}">`;return`<h2>ตั้งค่า</h2><div class=card><label style="color:inherit"><input type=checkbox id=s_open ${s.open!==false?'checked':''} style="width:auto"> เปิดรับออเดอร์</label>${f('shop_name','ชื่อร้าน','text',s.shop_name)}${f('promptpay','PromptPay (เบอร์ 10 หลัก/เลขบัตร 13 หลัก)','text',s.promptpay)}${f('baht_per_point','ทุกกี่บาทได้ 1 แต้ม','number',s.baht_per_point??10)}<p><button class=p onclick="A.saveSet()">บันทึก</button></p></div>`}
def({async saveSet(){const pp=$('#s_promptpay').value.replace(/\D/g,''),bp=+$('#s_baht_per_point').value;if(pp&&pp.length!=10&&pp.length!=13)throw Error('PromptPay ต้องเป็น 10 หรือ 13 หลัก');if(!(bp>=1))throw Error('อัตราแต้มต้องตั้งแต่ 1 บาทขึ้นไป');
await Q(sb.from('settings').upsert([{key:'open',value:$('#s_open').checked},{key:'shop_name',value:$('#s_shop_name').value.trim()},{key:'promptpay',value:pp},{key:'baht_per_point',value:bp}]));toast('บันทึกแล้ว ✅');await A.go2()},async go2(){await stf()}});
route();
