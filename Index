cancel(id){ask('ยกเลิกออเดอร์นี้? ย้อนกลับไม่ได้',async()=>{await Q(sb.from('orders').update({status:'cancel'}).eq('id',id));await shell()})},
mem(id){modal(`<h3>ผูกสมาชิก</h3><label>เบอร์โทร</label><input id=mp inputmode=tel><label>ชื่อ (ไม่บังคับ)</label><input id=mn><p><button class=p style="width:100%" onclick="A.mem2(${id})">บันทึก</button></p>`)},
async mem2(id){await Q(sb.rpc('attach_member',{p_order:id,p_phone:$('#mp').value,p_name:$('#mn').value||null}));closeM();await shell()},
async pay(id,m){await Q(sb.rpc('confirm_payment',{p_order:id,p_method:m}));await A.receipt(id);await shell()},
async receipt(id){const no=await Q(sb.rpc('issue_receipt',{p_order:id})),o=await Q(sb.from('orders').select('*,order_items(*)').eq('id',id).single());modal(rcHtml(o,no))}});
/* ===== จัดการข้อมูลแบบตารางเดียวกันทุกหน้า ===== */
const CK=[['percent','เปอร์เซ็นต์'],['amount','บาท']],RES={
menu_items:['เมนู',r=>`${r.name} · ${B(r.price)}${r.popular?' 🔥':''}${r.out_of_stock?' · หมด':''}${r.active?'':' · ปิด'}`,[['name','ชื่อเมนู'],['description','คำอธิบาย'],['price','ราคา','number'],['category_id','หมวด','cats'],['popular','ยอดนิยม','bool'],['out_of_stock','หมด','bool'],['active','เปิดขาย','bool']]],
categories:['หมวดหมู่',r=>r.name,[['name','ชื่อหมวด'],['sort','ลำดับ','number'],['active','ใช้งาน','bool']]],
promotions:['โปรโมชัน',r=>`${r.name} · ${r.kind=='percent'?r.value+'%':B(r.value)}${r.start_time?` · ${r.start_time.slice(0,5)}-${(r.end_time||'').slice(0,5)}`:''}${r.active?'':' · ปิด'}`,[['name','ชื่อโปร'],['kind','ประเภทส่วนลด',CK],['value','ค่าลด','number'],['scope','ใช้กับ',[['order','ทั้งบิล'],['category','เฉพาะหมวด'],['item','เฉพาะเมนู']]],['category_id','หมวด (เมื่อเลือกเฉพาะหมวด)','cats'],['item_id','เมนู (เมื่อเลือกเฉพาะเมนู)','menu'],['min_subtotal','ยอดขั้นต่ำ','number'],['days','วัน 1=จันทร์..7=อาทิตย์ คั่นด้วย , (ว่าง=ทุกวัน)','days'],['start_time','เริ่มเวลา','time'],['end_time','ถึงเวลา','time'],['starts_at','เริ่มวันที่','dt'],['ends_at','ถึงวันที่','dt'],['active','เปิดใช้','bool']]],
coupons:['โค้ดส่วนลด',r=>`${r.code} · ${r.kind=='percent'?r.value+'%':B(r.value)} · ใช้แล้ว ${r.used_count}/${r.max_uses??'∞'}${r.active?'':' · ปิด'}`,[['code','โค้ด'],['kind','ประเภทส่วนลด',CK],['value','ค่าลด','number'],['max_discount','ลดสูงสุด (บาท)','number'],['min_subtotal','ยอดขั้นต่ำ','number'],['max_uses','จำนวนสิทธิ์ทั้งหมด','number'],['expires_at','หมดอายุ','dt'],['active','เปิดใช้','bool']]],
rewards:['ของรางวัลแลกแต้ม',r=>`${r.name} · ${r.points_cost} แต้ม${r.stock!=null?` · เหลือ ${r.stock}`:''}`,[['name','ชื่อ'],['points_cost','แต้มที่ใช้','number'],['kind','ประเภท',[['amount','ส่วนลดบาท'],['percent','ส่วนลด %'],['free_item','ของแถม']]],['value','มูลค่าส่วนลด','number'],['stock','จำนวนคงเหลือ (ว่าง=ไม่จำกัด)','number'],['active','เปิดใช้','bool']]]};
async function adm(res){const[t,show]=RES[res],rows=await Q(sb.from(res).select('*').order('id',{ascending:false}));
return`<div class=row><h2>${t}</h2><span>${res=='coupons'?'<button onclick="A.batch()">แจกโค้ดหลายใบ</button> ':''}<button class=p onclick="A.form('${res}')">+ เพิ่ม</button></span></div>${rows.map(r=>`<div class=card><div class=row><span>${e(show(r))}</span><span><button onclick="A.form('${res}',${r.id})">แก้ไข</button> <button class=r onclick="A.del('${res}',${r.id})">ลบ</button></span></div></div>`).join('')||'<p>ยังไม่มีข้อมูล</p>'}`}
def({async form(res,id){const fs=RES[res][2],row=id?await Q(sb.from(res).select('*').eq('id',id).single()):{active:true};O.cats=(await Q(sb.from('categories').select('id,name').order('sort'))).map(x=>[x.id,x.name]);O.menu=(await Q(sb.from('menu_items').select('id,name'))).map(x=>[x.id,x.name]);
modal(`<h3>${RES[res][0]}</h3>${fs.map(([k,l,t])=>{const v=row[k];return t=='bool'?`<label style="color:inherit"><input type=checkbox id=f_${k} ${v?'checked':''} style="width:auto"> ${l}</label>`:`<label>${l}</label>${Array.isArray(t)||t=='cats'||t=='menu'?`<select id=f_${k}><option value="">—</option>${(Array.isArray(t)?t:O[t]).map(o=>`<option value="${o[0]}" ${String(v)==String(o[0])?'selected':''}>${e(o[1])}</option>`).join('')}</select>`:`<input id=f_${k} type=${t=='number'?'number step=any':t=='time'?'time':t=='dt'?'datetime-local':'text'} value="${e(t=='dt'?dl(v):t=='days'?(v||[]).join(','):v??'')}">`}`}).join('')}<p><button class=p style="width:100%" onclick="A.save('${res}',${id||0})">บันทึก</button></p>`)},
async save(res,id){const o={};RES[res][2].forEach(([k,,t])=>{const el=$('#f_'+k);let v=t=='bool'?el.checked:el.value.trim();if(t!='bool'){if(v==='')v=null;else if(t=='number'||k.endsWith('_id'))v=+v;else if(t=='dt')v=new Date(v).toISOString();else if(t=='days')v=v.split(',').map(Number).filter(Boolean);else if(k=='code')v=v.toUpperCase()}o[k]=v});
if(res=='coupons'&&!o.max_uses)throw Error('กรุณากำหนดจำนวนสิทธิ์ทั้งหมดของโค้ด');
if(id)await Q(sb.from(res).update(o).eq('id',id));else{const r=await Q(sb.from(res).insert(o).select().single());if(res=='menu_items'){const g=await Q(sb.from('option_groups').select('id'));g.length&&await Q(sb.from('menu_item_option_groups').insert(g.map(x=>({item_id:r.id,group_id:x.id}))))}}closeM();toast('บันทึกแล้ว ✅');await shell()},
del(res,id){ask('ลบรายการนี้? ย้อนกลับไม่ได้',async()=>{await Q(sb.from(res).delete().eq('id',id));await shell()})},
batch(){modal(`<h3>แจกโค้ดหลายใบ (ใบละ 1 สิทธิ์)</h3><label>คำนำหน้าโค้ด</label><input id=b1 value="PROMO"><label>จำนวนใบ (1-500)</label><input id=b2 type=number value=20><label>ประเภท</label><select id=b3>${CK.map(k=>`<option value=${k[0]}>${k[1]}</option>`).join('')}</select><label>ค่าลด</label><input id=b4 type=number><label>ลดสูงสุด (บาท ถ้าเป็น %)</label><input id=b5 type=number><label>ยอดขั้นต่ำ</label><input id=b6 type=number value=0><label>หมดอายุ</label><input id=b7 type=datetime-local><p><button class=p style="width:100%" onclick="A.batch2()">สร้างโค้ด</button></p>`)},
async batch2(){const n=x=>$(x).value===''?null:+$(x).value,c=await Q(sb.rpc('generate_coupons',{p_prefix:$('#b1').value,p_count:n('#b2'),p_kind:$('#b3').value,p_value:n('#b4'),p_max_discount:n('#b5'),p_min:n('#b6')||0,p_expires:$('#b7').value?new Date($('#b7').value).toISOString():null}));modal(`<h3>สร้างแล้ว ${c.length} โค้ด</h3><textarea style="width:100%;height:220px" readonly>${c.join('\n')}</textarea><p><button onclick="closeM();A.go()">ปิด</button></p>`)}});
