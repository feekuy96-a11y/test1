if(!S.ch)S.ch=sb.channel('live').on('postgres_changes',{event:'*',schema:'public',table:'orders'},x=>{x.eventType=='INSERT'&&(beep(),toast('🔔 มีออเดอร์ใหม่'));location.hash=='#/staff'&&S.v=='q'&&!$('#md.o')&&shell()}).on('postgres_changes',{event:'INSERT',schema:'public',table:'payments'},()=>{beep();toast('🧾 ลูกค้าส่งสลิป')}).subscribe();shell()}
const NAV=[['q','📋 คิว'],['menu_items','🍜 เมนู'],['categories','หมวดหมู่'],['promotions','🎉 โปรโมชัน'],['coupons','🏷️ โค้ด'],['rewards','🎁 ของรางวัล'],['mem','👥 สมาชิก'],['rep','📊 รายงาน'],['qr','🔳 QR โต๊ะ'],['set','⚙️ ตั้งค่า']];
async function shell(){const b=await({q:qView,mem:memView,rep:repView,qr:qrView,set:setView}[S.v]||(()=>adm(S.v)))();view(`<div class="w"><div class="row no"><b>${e(D.s.shop_name||'QOrder')}</b><span><a href="#/"><button>หน้าลูกค้า</button></a> <button onclick="A.out()">ออกจากระบบ</button></span></div><div class="chips no">${NAV.map(n=>`<button class="${S.v==n[0]?'on':''}" onclick="S.v='${n[0]}';A.go()">${n[1]}</button>`).join('')}</div>${b}</div>`)}
async function qView(){const os=await Q(sb.from('orders').select('*,order_items(*),members(name,phone,points),payments(*,files(url))').in('status',['new','cook','served']).order('created_at')),o=os.find(x=>x.id==S.sel)||os[0];
const det=o?`<div class="card cur"><div class=row><h3>โต๊ะ ${e(o.table_code)} · คิว ${o.order_no}</h3><span class="st ${o.status}">${ST[o.status]}</span></div><small>${ago(o.created_at)}${o.members?` · สมาชิก ${e(o.members.name||o.members.phone)} (${o.members.points} แต้ม)`:''}</small>${o.order_items.map(i=>`<div class=row><span>${e(i.name)} ×${i.qty}<br><small>${e((i.options||[]).join(', '))}</small></span><b>${B(i.qty*i.unit_price)}</b></div>`).join('')}<hr><div class=row><small>ราคา ${B(o.subtotal)} · โปรโมชัน −${B(o.promo_discount)} · โค้ด −${B(o.coupon_discount)}</small><h3 class=pr>${B(o.total)}</h3></div>${o.payments.filter(p=>p.status=='pending').map(p=>`<div class=tag>มีสลิปรอตรวจ ${p.files?.url?`<a href="${e(p.files.url)}" target=_blank rel=noopener>เปิดสลิป</a>`:''}</div>`).join('')}
<div class=chips>${o.status=='new'?`<button class=p onclick="A.st(${o.id},'cook')">เริ่มทำ</button>`:''}${o.status=='cook'?`<button class=p onclick="A.st(${o.id},'served')">เสิร์ฟแล้ว</button>`:''}<button onclick="A.mem(${o.id})">👤 ผูกสมาชิก</button><button class=r onclick="A.cancel(${o.id})">ยกเลิกออเดอร์</button></div>
<div class=row>${o.coupon_discount>0?`<button onclick="A.rmc(${o.id})">ลบโค้ดส่วนลด</button>`:`<input id=sc placeholder="คีย์โค้ดส่วนลดให้ลูกค้า" style="flex:1"><button onclick="A.cpn(${o.id},'#sc')">ใช้โค้ด</button>`}</div><div class=chips><button class=p onclick="A.pay(${o.id},'cash')">💵 รับเงินสด</button><button class=p onclick="A.pay(${o.id},'promptpay')">📲 ยืนยันรับโอน</button></div></div>`:'<div class=card>ยังไม่มีออเดอร์ค้าง</div>';
return`<h2>คิวออเดอร์ <span class=tag>เรียลไทม์</span></h2><div class=k2><div>${det}</div><div>${os.map(x=>`<div class="card ${o&&x.id==o.id?'cur':''}" onclick="S.sel=${x.id};A.go()" style="cursor:pointer"><div class=row><b>โต๊ะ ${e(x.table_code)} · #${x.order_no}</b><span class="st ${x.status}">${ST[x.status]}</span></div><div class=row><small>${ago(x.created_at)} · ${x.order_items.length} รายการ</small><b class=pr>${B(x.total)}</b></div></div>`).join('')}</div></div>`}
def({go:shell,
