<!DOCTYPE html><html lang="th"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>QOrder</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;600;800&family=Noto+Serif+Thai:wght@600;700&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--pri:#1f7a4d;--gold:#b98a3e;--bg:#f5f2ea;--card:#fffdf8;--tx:#16201a;--mu:#7a8177;--bd:#e6e0d1;--red:#d43b3b}
@media(prefers-color-scheme:dark){:root{--bg:#0c1210;--card:#141c18;--tx:#f1ede2;--mu:#98a196;--bd:#243029;--gold:#d9b46a}}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--tx);font:15px/1.5 'Noto Sans Thai',system-ui,sans-serif;padding:env(safe-area-inset-top) 0 90px}
h1,h2,h3,.pr{font-family:'Noto Serif Thai',serif;margin:0}.pr{color:var(--gold);font-weight:700}
button,input,select{font:inherit;color:inherit}button{cursor:pointer;border:1px solid var(--bd);background:var(--card);border-radius:12px;padding:8px 14px}
input,select{width:100%;padding:9px 12px;border:1px solid var(--bd);border-radius:10px;background:var(--card)}label{display:block;font-size:13px;color:var(--mu);margin:8px 0 3px}
.p{background:linear-gradient(135deg,var(--pri),#0f3d2a);color:#fff;border:0;font-weight:600}.r{color:var(--red)}.on{background:var(--pri)!important;color:#fff;border-color:var(--pri)!important}
.w{max-width:1100px;margin:0 auto;padding:14px}.row{display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap}
.card{background:var(--card);border:1px solid var(--bd);border-radius:18px;padding:12px;margin-bottom:10px}.cur{border-color:var(--pri);box-shadow:0 0 0 1px var(--pri)}
.hero{background:linear-gradient(160deg,#0f3d2a,#08170f);color:#fff;padding:26px 16px;border-bottom:2px solid var(--gold)}.hero small{color:#d9b46a}
.chips{display:flex;gap:6px;overflow-x:auto;padding:6px 0}.chips button{white-space:nowrap;border-radius:99px}
.g{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:10px}.it{text-align:left;display:flex;flex-direction:column;gap:3px;padding:10px}.it img{width:100%;height:96px;object-fit:cover;border-radius:12px}
.ph{height:96px;border-radius:12px;background:color-mix(in srgb,var(--pri) 14%,var(--card));display:flex;align-items:center;justify-content:center;font-size:36px}
.tag,.st{font-size:12px;padding:1px 9px;border-radius:99px;background:#fff3d6;color:#9a6200;display:inline-block}.st.paid{background:#dcf5df;color:#0d7a22}.st.cook{background:#dbeafe;color:#1d4ed8}.st.cancel{background:#fde2e2;color:var(--red)}
.nav{position:fixed;left:10px;right:10px;bottom:calc(10px + env(safe-area-inset-bottom));max-width:680px;margin:0 auto;display:flex;background:color-mix(in srgb,var(--card) 86%,transparent);backdrop-filter:blur(16px);border:1px solid var(--bd);border-radius:22px;box-shadow:0 14px 40px -14px #000a}
.nav button{flex:1;border:0;background:none;border-radius:22px;font-size:12px;color:var(--mu)}.nav .on{color:#fff}
.pill input:checked+span{background:var(--pri);color:#fff;border-color:var(--pri)}.pill span{display:inline-block;border:1px solid var(--bd);border-radius:99px;padding:6px 14px;cursor:pointer}
.k2{display:grid;grid-template-columns:1.4fr 1fr;gap:12px}@media(max-width:800px){.k2{grid-template-columns:1fr}}
.bar{height:8px;background:var(--pri);border-radius:6px;min-width:3px}table{width:100%;border-collapse:collapse}td,th{padding:6px;border-bottom:1px solid var(--bd);text-align:left;font-size:14px}
#md{position:fixed;inset:0;background:#0007;display:none;align-items:flex-end;justify-content:center;z-index:50}#md.o{display:flex}#md>div{background:var(--card);width:min(100%,520px);max-height:90vh;overflow:auto;border-radius:18px 18px 0 0;padding:16px}@media(min-width:600px){#md{align-items:center}#md>div{border-radius:18px}}
#toast{position:fixed;top:calc(10px + env(safe-area-inset-top));left:50%;transform:translateX(-50%);z-index:99;width:min(92vw,380px);display:flex;flex-direction:column;gap:6px}#toast div{background:#1b2119;color:#fff;padding:10px 14px;border-radius:12px}#toast .err{background:var(--red)}
@media print{body.prc>*:not(#md){display:none!important}body.prc #md{position:static;background:none;display:block}body.prc #md button{display:none}.no{display:none!important}}
</style></head><body><div id="app"></div><div id="md"><div id="mc"></div></div><div id="toast"></div>
<script>
/* ===== ตั้งค่า: ใส่ค่าของคุณ (anon key เปิดเผยได้ ความปลอดภัยอยู่ที่ RLS ใน schema.sql) ===== */
const CFG={SUPABASE_URL:'',SUPABASE_ANON:'',BRIDGE_URL:''};
/* ===== พื้นฐาน ===== */
const $=s=>document.querySelector(s),e=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])),B=n=>'฿'+Number(n||0).toLocaleString('th-TH',{maximumFractionDigits:2});
const sb=CFG.SUPABASE_URL&&CFG.SUPABASE_ANON?supabase.createClient(CFG.SUPABASE_URL,CFG.SUPABASE_ANON):null;
const Q=async p=>{const{data,error}=await p;if(error)throw new Error(error.message);return data};
const S={cart:[],cat:'ทั้งหมด',q:'',tab:'m',v:'q',orders:[]},D={},O={},A={};
const view=h=>$('#app').innerHTML=h,closeM=()=>$('#md').classList.remove('o'),modal=h=>{$('#mc').innerHTML=h;$('#md').classList.add('o')};
const toast=(m,t)=>{const d=document.createElement('div');d.textContent=m;t&&(d.className=t);$('#toast').append(d);setTimeout(()=>d.remove(),3800)};
const def=o=>Object.keys(o).forEach(k=>A[k]=async(...a)=>{try{await o[k](...a)}catch(x){toast(x.message,'err')}});
const ask=(m,fn)=>{A._y=async()=>{closeM();await fn()};modal(`<h3>${e(m)}</h3><div class=row style="margin-top:14px"><button onclick="closeM()">ยกเลิก</button><button class=p onclick="A._y()">ยืนยัน</button></div>`)};
const beep=()=>{try{const a=new AudioContext(),o=a.createOscillator();o.frequency.value=880;o.connect(a.destination);o.start();o.stop(a.currentTime+.25)}catch(x){}};
const ST={new:'รอรับ',cook:'กำลังทำ',served:'เสิร์ฟแล้ว',paid:'ชำระแล้ว',cancel:'ยกเลิก'},em=c=>({ข้าว:'🍛',ก๋วยเตี๋ยว:'🍜',อาหารย่าง:'🥩',ของหวาน:'🍰',เครื่องดื่ม:'🥤'}[c]||'🍽️');
const ago=t=>{const m=Math.floor((Date.now()-new Date(t))/6e4);return m<1?'เพิ่งสั่ง':m+' นาทีที่แล้ว'},dl=v=>v?new Date(new Date(v)-new Date().getTimezoneOffset()*6e4).toISOString().slice(0,16):'';
const tbl=(h,r)=>`<table><tr>${h.map(x=>`<th>${x}</th>`).join('')}</tr>${r.map(x=>`<tr>${x.map(y=>`<td>${y}</td>`).join('')}</tr>`).join('')||`<tr><td colspan=${h.length}>ยังไม่มีข้อมูล</td></tr>`}</table>`;
function ppay(id,amt){id=String(id).replace(/\D/g,'');const t=id.length>=13?'02':'01',n=t=='01'?'0066'+id.slice(1):id,f=(a,b)=>a+String(b.length).padStart(2,'0')+b;let p=f('00','01')+f('01','12')+f('29',f('00','A000000677010111')+f(t,n))+f('53','764')+f('54',Number(amt).toFixed(2))+f('58','TH')+'6304',c=0xFFFF;for(const ch of p){c^=ch.charCodeAt(0)<<8;for(let i=0;i<8;i++)c=c&0x8000?(c<<1)^0x1021:c<<1;c&=0xFFFF}return p+c.toString(16).toUpperCase().padStart(4,'0')}
const qr=(el,t)=>{try{new QRCode(el,{text:t,width:170,height:170})}catch(x){el.textContent='โหลดตัวสร้าง QR ไม่ได้'}};
const shrink=(f,w)=>new Promise((ok,no)=>{const r=new FileReader();r.onload=()=>{const i=new Image();i.onload=()=>{const k=Math.min(1,w/i.width),c=document.createElement('canvas');c.width=i.width*k;c.height=i.height*k;c.getContext('2d').drawImage(i,0,0,c.width,c.height);ok(c.toDataURL('image/jpeg',.7).split(',')[1])};i.onerror=()=>no(Error('ไฟล์รูปไม่ถูกต้อง'));i.src=r.result};r.readAsDataURL(f)});
async function bridge(kind,name,data,token){const r=await(await fetch(CFG.BRIDGE_URL,{method:'POST',headers:{'Content-Type':'text/plain'},body:JSON.stringify({kind,name,mime:'image/jpeg',data,token})})).json();if(r.error)throw Error('อัปโหลดไม่สำเร็จ: '+r.error);return r}
addEventListener('unhandledrejection',x=>toast(x.reason?.message||'เกิดข้อผิดพลาด','err'));
/* ===== เส้นทาง ===== */
function route(){clearInterval(S.iv);const[h,a]=location.hash.slice(2).split('/');(h=='t'?cust:h=='staff'?stf:home)(decodeURIComponent(a||'')).catch(x=>toast(x.message,'err'))}
addEventListener('hashchange',route);
async function home(){if(!sb)return view(`<div class=w><div class=card><h2>ตั้งค่าครั้งแรก</h2><p>เปิดไฟล์ index.html แล้วใส่ SUPABASE_URL, SUPABASE_ANON และ BRIDGE_URL ในบรรทัด CFG ด้านบนสุดของสคริปต์</p></div></div>`);
const t=await Q(sb.from('floor_objects').select('code').in('kind',['square','round']).order('code'));view(`<div class=hero><h1>QOrder</h1><small>เลือกโต๊ะ (เหมือนสแกน QR)</small></div><div class=w><div class=g>${t.map(x=>`<a href="#/t/${encodeURIComponent(x.code)}"><button style="width:100%">${e(x.code)}</button></a>`).join('')}</div><p><a href="#/staff"><button class=p>เข้าระบบพนักงาน</button></a></p></div>`)}
/* ===== ลูกค้า ===== */
async function loadMenu(){const r=await Promise.all([['categories','*','sort'],['menu_items','*,files(url)','id'],['option_groups','*','id'],['option_choices','*','sort'],['menu_item_option_groups','*','item_id'],['promotions','*','id'],['settings','*','key']].map(([t,sel,o])=>Q(sb.from(t).select(sel).order(o))));[D.cats,D.menu,D.groups,D.choices,D.links,D.promos,D.set]=r;D.s=Object.fromEntries(D.set.map(x=>[x.key,x.value]))}
const refOrders=async()=>S.orders=await Q(sb.rpc('table_orders',{p_table:S.t}));
async function cust(t){S.t=t;if(!D.menu)await loadMenu();await refOrders();draw();S.iv=setInterval(async()=>{if(!$('#md.o')&&!/INPUT/.test(document.activeElement.tagName)){await refOrders();S.tab!='m'&&draw()}},6000)}
const grid=()=>{const l=D.menu.filter(m=>m.active&&(S.cat=='ทั้งหมด'||m.category_id==S.cat)&&m.name.includes(S.q));return l.map(m=>{const c=D.cats.find(x=>x.id==m.category_id);return`<button class="card it" onclick="A.item(${m.id})" ${m.out_of_stock?'disabled style="opacity:.5"':''}>${m.files?.url?`<img src="${e(m.files.url)}" alt="">`:`<div class=ph>${em(c?.name)}</div>`}<span>${m.popular?'<span class=tag>🔥 ยอดนิยม</span> ':''}${m.out_of_stock?'<span class=tag>หมด</span>':''}</span><b>${e(m.name)}</b><small>${e(m.description)}</small><span class=pr>${B(m.price)}</span></button>`}).join('')||'<p>ไม่พบเมนู</p>'};
function draw(){const n=S.cart.reduce((a,l)=>a+l.qty,0),open=D.s.open!==false,un=S.orders.filter(o=>!['paid','cancel'].includes(o.status));let b='';
if(S.tab=='m')b=`<input placeholder="🔍 ค้นหาเมนู..." value="${e(S.q)}" oninput="S.q=this.value;$('#grid').innerHTML=grid()">${open?'':'<div class=card style="border-color:var(--red)">ร้านปิดรับออเดอร์ชั่วคราว</div>'}${D.promos.filter(p=>p.active).map(p=>`<span class=tag>🎉 ${e(p.name)}</span> `).join('')}<div class=chips>${[{id:'ทั้งหมด',name:'ทั้งหมด'},...D.cats.filter(c=>c.active)].map(c=>`<button class="${c.id==S.cat?'on':''}" onclick="S.cat='${c.id}';draw()">${e(c.name)}</button>`).join('')}</div><div class=g id=grid>${grid()}</div>`;
else if(S.tab=='c'){const s=S.cart.reduce((a,l)=>a+l.price*l.qty,0);b=S.cart.length?S.cart.map((l,i)=>`<div class=card><div class=row><b>${e(l.name)}</b><span class=pr>${B(l.price*l.qty)}</span></div><small>${e(l.opts)}</small><div><button onclick="A.qty(${i},-1)">−</button> <b>${l.qty}</b> <button onclick="A.qty(${i},1)">+</button></div></div>`).join('')+`<div class=card><label>เบอร์โทร (ไม่บังคับ) สะสมแต้ม/รับสิทธิ์ — ยินยอมให้ร้านเก็บข้อมูลเพื่อสมาชิกและการตลาด</label><input id=ph inputmode=tel></div><div class=row><h3>รวม ${B(s)}</h3><button class=p onclick="A.place()">ส่งออเดอร์เข้าครัว</button></div><small>ส่วนลดโปรโมชัน/โค้ดคิดตอนสั่งและตอนชำระเงิน</small>`:'<p>ตะกร้าว่าง</p>'}
else if(S.tab=='s')b=S.orders.slice().reverse().map(o=>`<div class=card><div class=row><b>ออเดอร์ #${o.order_no}</b><span class="st ${o.status}">${ST[o.status]}</span></div>${o.items.map(i=>`<div>${e(i.name)} ×${i.qty} <small>${e((i.options||[]).join(', '))}</small></div>`).join('')}<div class=row><small>${ago(o.created_at)}</small><span class=pr>${B(o.total)}</span>${o.status=='paid'?`<button onclick="A.rc(${o.id})">🧾 ใบเสร็จ</button>`:''}</div></div>`).join('')||'<p>ยังไม่มีออเดอร์</p>';
else b=un.map(o=>`<div class=card><div class=row><b>ออเดอร์ #${o.order_no}</b><span class=pr>${B(o.total)}</span></div><small>ราคา ${B(o.subtotal)} · โปรโมชัน −${B(o.promo_discount)} · โค้ด −${B(o.coupon_discount)}</small><div class=row style="margin-top:6px">${o.coupon_discount>0?`<button onclick="A.rmc(${o.id})">ลบโค้ด</button>`:`<input id=cp${o.id} placeholder="โค้ดส่วนลด" style="flex:1"><button onclick="A.cpn(${o.id},'#cp${o.id}')">ใช้โค้ด</button>`}</div><div id=qr${o.id} style="display:flex;justify-content:center;padding:10px"></div><label>แนบสลิปหลังโอน</label><input type=file accept="image/*" onchange="A.slip(${o.id},this.files[0])"></div>`).join('')||'<p>ไม่มียอดค้างชำระ</p>';
view(`<div class=hero><small>โต๊ะ ${e(S.t)}</small><h1>${e(D.s.shop_name||'ร้านอาหาร')}</h1></div><div class=w>${b}</div><nav class=nav>${[['m','🍽️','เมนู'],['c','🛒','ตะกร้า ('+n+')'],['s','⏱️','สถานะ'],['p','💳','ชำระเงิน']].map(x=>`<button class="${S.tab==x[0]?'on':''}" onclick="S.tab='${x[0]}';draw()">${x[1]}<br>${x[2]}</button>`).join('')}</nav>`);
if(S.tab=='p')un.forEach(o=>qr($('#qr'+o.id),ppay(D.s.promptpay||'',o.total)))}
def({item(id){const m=D.menu.find(x=>x.id==id),gs=D.links.filter(l=>l.item_id==id).map(l=>D.groups.find(g=>g.id==l.group_id)).filter(Boolean);
modal(`<h3>${e(m.name)}</h3><small>${e(m.description)}</small><div class=pr style="font-size:22px">${B(m.price)}</div>${gs.map(g=>`<div class=card><b>${e(g.name)}</b>${g.required?' <span class=tag>จำเป็น</span>':''}<div class=chips>${D.choices.filter(c=>c.group_id==g.id).map((c,i)=>`<label class=pill><input hidden type=${g.multi?'checkbox':'radio'} name=g${g.id} value=${c.id} ${g.required&&!i?'checked':''}><span>${e(c.name)}${c.price_delta>0?' +'+B(c.price_delta):''}</span></label>`).join('')}</div></div>`).join('')}<button class=p style="width:100%" onclick="A.addLine(${id})">เพิ่มลงตะกร้า</button>`)},
addLine(id){const m=D.menu.find(x=>x.id==id),ch=[...document.querySelectorAll('#mc input:checked')].map(i=>+i.value),cs=D.choices.filter(c=>ch.includes(c.id));
D.links.filter(l=>l.item_id==id).map(l=>D.groups.find(g=>g.id==l.group_id)).filter(g=>g&&g.required).forEach(g=>{if(!cs.some(c=>c.group_id==g.id))throw Error('กรุณาเลือก '+g.name)});
const price=Number(m.price)+cs.reduce((a,c)=>a+Number(c.price_delta),0),key=id+'|'+ch.sort(),l=S.cart.find(x=>x.key==key);l?l.qty++:S.cart.push({key,id,name:m.name,price,qty:1,ch,opts:cs.map(c=>c.name).join(', ')});closeM();toast('เพิ่ม '+m.name+' แล้ว');draw()},
qty(i,d){S.cart[i].qty+=d;S.cart[i].qty<1&&S.cart.splice(i,1);draw()},
place(){ask('ยืนยันส่งออเดอร์เข้าครัว?',A.doPlace)},
async doPlace(){if(S.busy)return;S.busy=1;try{await Q(sb.rpc('place_order',{p_table:S.t,p_items:S.cart.map(l=>({item_id:l.id,qty:l.qty,choices:l.ch})),p_phone:$('#ph')?.value||null}));S.cart=[];S.tab='s';toast('ส่งออเดอร์แล้ว ✅');await refOrders();draw()}finally{S.busy=0}},
async cpn(id,sel){const c=$(sel).value.trim();if(!c)throw Error('กรอกโค้ดก่อน');const d=await Q(sb.rpc('apply_coupon',{p_order:id,p_code:c}));toast('ใช้โค้ดสำเร็จ ลด '+B(d));S.v=='q'&&location.hash=='#/staff'?await shell():(await refOrders(),draw())},
async rmc(id){await Q(sb.rpc('remove_coupon',{p_order:id}));S.v=='q'&&location.hash=='#/staff'?await shell():(await refOrders(),draw())},
async slip(id,f){if(!f)return;if(!CFG.BRIDGE_URL)throw Error('ยังไม่ได้ตั้งค่า BRIDGE_URL');const r=await bridge('slip','slip-'+id+'.jpg',await shrink(f,900));await Q(sb.rpc('submit_slip',{p_order:id,p_drive_id:r.drive_file_id,p_url:r.url}));toast('ส่งสลิปแล้ว รอร้านตรวจสอบ ✅')},
rc(id){const o=S.orders.find(x=>x.id==id);modal(rcHtml(o,''))}});
const rcHtml=(o,no)=>`<div><h3 style="text-align:center">${e(D.s?.shop_name||'')}</h3><p style="text-align:center"><small>ใบเสร็จรับเงิน ${e(no)} · โต๊ะ ${e(o.table_code)} · ${new Date(o.paid_at||o.created_at).toLocaleString('th-TH')}</small></p><hr>${(o.items||o.order_items).map(i=>`<div class=row><span>${e(i.name)} ×${i.qty}</span><span>${B(i.qty*i.unit_price)}</span></div>`).join('')}<hr><div class=row><span>ยอดรวม</span><span>${B(o.subtotal)}</span></div><div class=row><span>ส่วนลดโปรโมชัน</span><span>−${B(o.promo_discount)}</span></div><div class=row><span>ส่วนลดโค้ด</span><span>−${B(o.coupon_discount)}</span></div><div class=row><b>สุทธิ</b><b class=pr>${B(o.total)}</b></div><p style="text-align:center"><small>ขอบคุณที่ใช้บริการ</small></p></div><button class=p style="width:100%" onclick="document.body.classList.add('prc');print();setTimeout(()=>document.body.classList.remove('prc'),600)">🖨️ พิมพ์</button>`;
/* ===== พนักงาน ===== */
async function stf(){const{data:{session}}=await sb.auth.getSession();if(!session)return view(`<div class=w style="max-width:380px"><div class=card><h2>เข้าสู่ระบบพนักงาน</h2><label>อีเมล</label><input id=em type=email><label>รหัสผ่าน</label><input id=pw type=password><p><button class=p style="width:100%" onclick="A.login()">เข้าสู่ระบบ</button></p></div></div>`);
const p=await Q(sb.from('profiles').select('role').eq('user_id',session.user.id).maybeSingle());if(!p)return view(`<div class=w><div class=card>บัญชีนี้ยังไม่ได้รับสิทธิ์พนักงาน ให้เจ้าของเพิ่มในตาราง profiles<p><button onclick="A.out()">ออกจากระบบ</button></p></div></div>`);
